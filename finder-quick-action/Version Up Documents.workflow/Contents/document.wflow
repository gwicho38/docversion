				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>export PATH="$HOME/.local/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"
LOG="$HOME/Library/Logs/docversion-quickaction.log"
PATTERN=$(osascript -e 'text returned of (display dialog "File pattern to version (e.g. *.docx, *.pdf, Report*)" default answer "*.docx" with title "docversion sync")' 2&gt;/dev/null)
if [ -z "$PATTERN" ]; then
  exit 0
fi
{
  echo "== $(date) : pattern=$PATTERN =="
  for f in "$@"; do
    docversion sync "$f" "$PATTERN"
  done
} &gt;&gt; "$LOG" 2&gt;&amp;1
osascript -e 'display notification "done — see ~/Library/Logs/docversion-quickaction.log" with title "docversion sync"'
</string>
